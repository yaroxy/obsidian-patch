{
  "name": "patches",
  "version": "0.3.0",
  "description": "Focused fixes and enhancements for Obsidian.",
  "main": "dist/community/main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:full": "node esbuild.config.mjs development full",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "build:full": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production full",
    "check:release": "node scripts/check-release.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "obsidian",
    "patch",
    "mermaid",
    "diagram"
  ],
  "author": "yaroxy",
  "license": "MIT",
  "dependencies": {
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/material-icon-theme": "^1.2.77",
    "@mermaid-js/layout-elk": "^1.0.2",
    "mermaid": "12.3.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "^7.0.2"
  }
}
