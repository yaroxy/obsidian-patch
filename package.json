{
  "name": "patches",
  "version": "0.8.0",
  "description": "Focused fixes and enhancements for Obsidian.",
  "main": "dist/community/main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check:release": "node scripts/check-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "docs:dev": "node scripts/prepare-site.mjs && vitepress dev site --host 127.0.0.1 --port 4173 --strictPort",
    "docs:build": "node scripts/prepare-site.mjs && vitepress build site",
    "docs:preview": "vite preview --outDir site/.vitepress/dist --base /obsidian-patch/ --host 127.0.0.1 --port 4173 --strictPort",
    "docs:check": "node scripts/check-site.mjs"
  },
  "keywords": [
    "obsidian",
    "patch",
    "mermaid",
    "diagram"
  ],
  "author": "yaroxy",
  "license": "MIT",
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "diff": "9.0.0",
    "dompurify": "3.4.18",
    "markdown-it": "15.0.3",
    "mermaid": "12.3.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/material-icon-theme": "^1.2.77",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4",
    "vite": "8.3.8"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.5"
    }
  }
}
